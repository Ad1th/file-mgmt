<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Folder</title>
</head>
<body>
    <h1>Folder: <%= folder.name %></h1>

    <h2>Upload File to Folder</h2>
    <form action="/folder/<%= folder.id %>/upload" method="POST" enctype="multipart/form-data">
        <label for="file-upload">Choose a file:</label>
        <input type="file" id="file-upload" name="file" required>
        <br>
        <button type="submit">Upload</button>
    </form>

    <h2>Files in Folder</h2>
    <ul>
        <% if (files && files.length > 0) { %>
            <% files.forEach(file => { %>
                <li><a href="<%= file.url %>" target="_blank"><%= file.name %></a></li>
            <% }); %>
        <% } else { %>
            <li>No files in this folder.</li>
        <% } %>
    </ul>

    <h2>Subfolders</h2>
    <ul>
        <% if (subfolders && subfolders.length > 0) { %>
            <% subfolders.forEach(subfolder => { %>
                <li><a href="/folder/<%= subfolder.id %>"><%= subfolder.name %></a></li>
            <% }); %>
        <% } else { %>
            <li>No subfolders available.</li>
        <% } %>
    </ul>

    <h2>Create New Subfolder</h2>
    <form action="/create-folder" method="POST">
        <input type="hidden" name="parentId" value="<%= folder.id %>">
        <label for="subfolder-name">Subfolder Name:</label>
        <input type="text" id="subfolder-name" name="folderName" required>
        <br>
        <button type="submit">Create Subfolder</button>
    </form>
</body>
</html>